# .env example for backend

# Supabase (Postgres) — rode supabase-schema.sql no SQL editor do projeto antes de usar.
# Use a service_role key aqui (o backend precisa bypassar RLS e filtrar por tenant_id no código).
# Dashboard do Supabase > Project Settings > API.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_KEY="<service_role_key>"

# JWT Secrets (use strong random values in production!)
JWT_PRIVATE_KEY="supersecret"
JWT_PUBLIC_KEY="supersecret"

# Server Port
PORT=3000

# Stripe — Dashboard > Developers > API keys / Webhooks
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# URL do frontend, usada nos redirects de sucesso/cancelamento do Checkout
FRONTEND_URL="http://localhost:5173"

# Cloudinary — upload de imagens (logo, galeria da barbearia).
# Dashboard do Cloudinary > raiz da página, os 3 valores aparecem prontos em "API Environment variable".
CLOUDINARY_CLOUD_NAME="<cloud_name>"
CLOUDINARY_API_KEY="<api_key>"
CLOUDINARY_API_SECRET="<api_secret>"
